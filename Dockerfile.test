# Dockerfile.test - ProcMon builds this, runs the container, treats a non-zero exit as a test failure.
# pytest is the build gate, including the `ocr` tests (REQUIRE_TESSERACT=1: a missing binary is a failure). Hermetic: fixtures only, no network.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-slk && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-dev.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY . .
ENV PYTHONPATH=/app/src
ENV REQUIRE_TESSERACT=1
ENTRYPOINT ["python", "-m", "pytest", "-q", "-m", "not integration"]
